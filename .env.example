# PostgreSQL externo com TLS. Necessário para persistência e migrações.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# LiveKit Cloud ou serviço self-hosted. Necessário apenas para voz real.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Armazenamento S3 compatível (opcional). O bucket deve ser privado.
STORAGE_ENDPOINT=https://YOUR_S3_ENDPOINT
STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
STORAGE_REGION=YOUR_REGION
STORAGE_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# Cookies do site HTTPS/Preview incorporado. Só alterar para testes locais em HTTP.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Runtime
PORT=3000
NODE_ENV=development
PG_POOL_SIZE=8

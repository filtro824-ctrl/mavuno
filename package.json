{
  "name": "mavuno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "start": "node dist/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration-smoke.ts"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "drizzle-orm": "0.39.3",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "pg": "8.13.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "drizzle-kit": "0.30.5",
    "esbuild": "0.25.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "6.2.2"
  }
}
